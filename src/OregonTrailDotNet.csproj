<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The host runs behind Apache on Linux; skip the IIS web.config the Web SDK would publish. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WolfCurses" Version="2018.9.12.1" />
    <InternalsVisibleTo Include="OregonTrail.BackendTests" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot/app.bc.js" />
    <!-- The idea catalog is read from the assembly; the Web SDK would also copy it as loose content. -->
    <Content Remove="Module/Creator/video-ideas.json" />
    <EmbeddedResource Include="Module/Creator/video-ideas.json" />
  </ItemGroup>

</Project>
